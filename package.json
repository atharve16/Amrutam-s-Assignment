{
  "name": "amrutam-telemedicine-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented REST API foundation for Amrutam telemedicine",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13 <23 || >=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/env-validation.spec.js dist/test/health-smoke.spec.js dist/test/migration-contract.spec.js dist/test/schema-verifier-cleanup.spec.js dist/test/domain-rules.spec.js dist/test/observability.spec.js",
    "test:integration": "npm run build && node --env-file-if-exists=.env --test dist/test/postgres-booking.integration.spec.js",
    "schema:verify": "npm run build && node --env-file-if-exists=.env dist/scripts/verify-schema.js",
    "smoke": "node scripts/smoke-health.mjs",
    "migration:run": "npm run build && node --env-file-if-exists=.env dist/scripts/migrate.js",
    "admin:bootstrap": "npm run build && node --env-file-if-exists=.env dist/scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.6",
    "@prometheus-io/client": "0.16.1",
    "argon2": "^0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@types/express": "5.0.5",
    "@types/node": "22.18.12",
    "@types/pg": "8.15.6",
    "eslint": "10.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "js-yaml": "5.4.1",
    "multer": "2.5.0"
  }
}
