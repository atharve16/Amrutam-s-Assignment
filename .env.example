NODE_ENV=development
PORT=3000
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
APP_ORIGIN=http://localhost:3001
LOG_LEVEL=log

# Supabase generally requires TLS. Set false only for an explicitly trusted local database.
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
SWAGGER_ENABLED=true
REQUEST_BODY_LIMIT=100kb

# Optional: only for `npm run schema:verify` and `npm run test:integration` against a
# disposable development database. Both commands create and remove isolated schemas.
SCHEMA_TEST_DATABASE_URL=postgres-uri
SCHEMA_TEST_DATABASE_SSL=true
SCHEMA_TEST_CONFIRM_DISPOSABLE=no

# One-time initial administrator bootstrap. Supply only while running `npm run admin:bootstrap`.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=
